<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.activity.mapper.CommentMapper">

    <resultMap id="BaseResultMap" type="com.campus.activity.entity.Comment">
        <id column="id" property="id"/>
        <result column="activity_id" property="activityId"/>
        <result column="user_id" property="userId"/>
        <result column="content" property="content"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO activity_comment (activity_id, user_id, content, created_at)
        VALUES (#{activityId}, #{userId}, #{content}, NOW())
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM activity_comment
        WHERE id = #{id}
    </select>

    <select id="selectByActivityId" resultMap="BaseResultMap">
        SELECT * FROM activity_comment
        WHERE activity_id = #{activityId}
        ORDER BY created_at DESC
        LIMIT #{offset}, #{size}
    </select>

    <select id="countByActivityId" resultType="java.lang.Long">
        SELECT COUNT(*) FROM activity_comment
        WHERE activity_id = #{activityId}
    </select>

    <delete id="deleteById">
        DELETE FROM activity_comment WHERE id = #{id}
    </delete>

</mapper>
