<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.activity.mapper.ActivityAlbumMapper">
    <resultMap id="BaseResultMap" type="com.campus.activity.entity.ActivityAlbum">
        <id column="id" property="id"/>
        <result column="activity_id" property="activityId"/>
        <result column="url" property="url"/>
        <result column="thumbnail_url" property="thumbnailUrl"/>
        <result column="description" property="description"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="created_at" property="createdAt"/>
        <result column="created_by" property="createdBy"/>
    </resultMap>

    <select id="selectByActivityId" resultMap="BaseResultMap">
        SELECT * FROM activity_album 
        WHERE activity_id = #{activityId}
        ORDER BY sort_order ASC, created_at DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM activity_album WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO activity_album (activity_id, url, thumbnail_url, description, sort_order, created_at, created_by)
        VALUES (#{activityId}, #{url}, #{thumbnailUrl}, #{description}, #{sortOrder}, NOW(), #{createdBy})
    </insert>

    <delete id="deleteById">
        DELETE FROM activity_album WHERE id = #{id}
    </delete>

    <delete id="deleteByActivityId">
        DELETE FROM activity_album WHERE activity_id = #{activityId}
    </delete>

    <select id="countByActivityId" resultType="int">
        SELECT COUNT(*) FROM activity_album WHERE activity_id = #{activityId}
    </select>
</mapper>
