<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.activity.mapper.ActivityTagMapper">

    <resultMap id="BaseResultMap" type="com.campus.activity.entity.ActivityTag">
        <id column="id" property="id"/>
        <result column="activity_id" property="activityId"/>
        <result column="name" property="name"/>
        <result column="color" property="color"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 插入标签 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO activity_tag (activity_id, name, color, created_at, updated_at)
        VALUES (#{activityId}, #{name}, #{color}, NOW(), NOW())
    </insert>

    <!-- 批量插入标签 -->
    <insert id="batchInsert">
        INSERT INTO activity_tag (activity_id, name, color, created_at, updated_at)
        VALUES
        <foreach collection="tags" item="tag" separator=",">
            (#{tag.activityId}, #{tag.name}, #{tag.color}, NOW(), NOW())
        </foreach>
    </insert>

    <!-- 根据ID删除标签 -->
    <delete id="deleteById">
        DELETE FROM activity_tag WHERE id = #{id}
    </delete>

    <!-- 根据活动ID删除标签 -->
    <delete id="deleteByActivityId">
        DELETE FROM activity_tag WHERE activity_id = #{activityId}
    </delete>

    <!-- 根据ID查询标签 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM activity_tag WHERE id = #{id}
    </select>

    <!-- 根据名称查询标签 -->
    <select id="selectByName" resultMap="BaseResultMap">
        SELECT * FROM activity_tag WHERE name = #{name} AND activity_id IS NULL LIMIT 1
    </select>

    <!-- 查询所有独立标签（activity_id为NULL） -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM activity_tag 
        WHERE activity_id IS NULL
        ORDER BY created_at DESC
    </select>

    <!-- 根据活动ID查询标签列表（直接使用activity_id关联） -->
    <select id="selectByActivityId" resultMap="BaseResultMap">
        SELECT * FROM activity_tag
        WHERE activity_id = #{activityId}
        ORDER BY created_at ASC
    </select>

    <!-- 根据多个活动ID查询标签列表 -->
    <select id="selectByActivityIds" resultMap="BaseResultMap">
        SELECT * FROM activity_tag
        WHERE activity_id IN
        <foreach collection="activityIds" item="activityId" open="(" separator="," close=")">
            #{activityId}
        </foreach>
        ORDER BY activity_id, created_at ASC
    </select>

    <!-- 删除活动与标签的关联关系（删除该活动的所有标签） -->
    <delete id="deleteRelationByActivityId">
        DELETE FROM activity_tag WHERE activity_id = #{activityId}
    </delete>

    <!-- 插入活动与标签的关联关系（直接插入带activity_id的标签） -->
    <insert id="insertRelation">
        INSERT INTO activity_tag (activity_id, name, color, created_at)
        VALUES (#{activityId}, #{tagName}, #{color}, NOW())
    </insert>

</mapper>