<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.core.mapper.AuditLogMapper">

    <resultMap id="BaseResultMap" type="com.campus.core.entity.AuditLog">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="target_user_id" property="targetUserId"/>
        <result column="username" property="username"/>
        <result column="operation" property="operation"/>
        <result column="resource_type" property="resourceType"/>
        <result column="resource_id" property="resourceId"/>
        <result column="request_method" property="requestMethod"/>
        <result column="request_path" property="requestPath"/>
        <result column="request_params" property="requestParams"/>
        <result column="response_status" property="responseStatus"/>
        <result column="response_message" property="responseMessage"/>
        <result column="client_ip" property="clientIp"/>
        <result column="user_agent" property="userAgent"/>
        <result column="execution_time" property="executionTime"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO audit_log (user_id, target_user_id, username, operation, resource_type, resource_id,
                               request_method, request_path, request_params,
                               response_status, response_message,
                               client_ip, user_agent, execution_time, created_at)
        VALUES (#{userId}, #{targetUserId}, #{username}, #{operation}, #{resourceType}, #{resourceId},
                #{requestMethod}, #{requestPath}, #{requestParams},
                #{responseStatus}, #{responseMessage},
                #{clientIp}, #{userAgent}, #{executionTime}, NOW())
    </insert>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM audit_log WHERE user_id = #{userId} ORDER BY created_at DESC
    </select>

    <select id="selectByOperation" resultMap="BaseResultMap">
        SELECT * FROM audit_log WHERE operation = #{operation} ORDER BY created_at DESC
    </select>

    <select id="selectRecent" resultMap="BaseResultMap">
        SELECT * FROM audit_log ORDER BY created_at DESC LIMIT #{limit}
    </select>

    <select id="countAll" resultType="java.lang.Long">
        SELECT COUNT(*) FROM audit_log
    </select>

    <delete id="deleteOldAuditLogs">
        DELETE FROM audit_log WHERE created_at &lt; #{cutoff}
    </delete>

    <!-- 分页查询审计日志（支持多条件筛选） -->
    <select id="selectByConditions" resultMap="BaseResultMap">
        SELECT * FROM audit_log
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="operation != null and operation != ''">
                AND operation = #{operation}
            </if>
            <if test="resourceType != null and resourceType != ''">
                AND resource_type = #{resourceType}
            </if>
            <if test="startTime != null">
                AND created_at &gt;= #{startTime}
            </if>
            <if test="endTime != null">
                AND created_at &lt;= #{endTime}
            </if>
        </where>
        ORDER BY created_at DESC
        LIMIT #{offset}, #{size}
    </select>

    <!-- 按条件统计审计日志数量 -->
    <select id="countByConditions" resultType="java.lang.Long">
        SELECT COUNT(*) FROM audit_log
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="operation != null and operation != ''">
                AND operation = #{operation}
            </if>
            <if test="resourceType != null and resourceType != ''">
                AND resource_type = #{resourceType}
            </if>
            <if test="startTime != null">
                AND created_at &gt;= #{startTime}
            </if>
            <if test="endTime != null">
                AND created_at &lt;= #{endTime}
            </if>
        </where>
    </select>

    <!-- 统计不同操作用户的数量（活跃用户数） -->
    <select id="countDistinctUsers" resultType="java.lang.Long">
        SELECT COUNT(DISTINCT user_id) FROM audit_log
    </select>

    <!-- 统计异常操作数量（响应状态码>=400的操作） -->
    <select id="countAbnormalOperations" resultType="java.lang.Long">
        SELECT COUNT(*) FROM audit_log WHERE response_status &gt;= 400
    </select>

</mapper>
