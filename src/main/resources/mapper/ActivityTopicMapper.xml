<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.activity.mapper.ActivityTopicMapper">

    <resultMap id="BaseResultMap" type="com.campus.activity.entity.ActivityTopic">
        <id column="id" property="id"/>
        <result column="activity_id" property="activityId"/>
        <result column="title" property="title"/>
        <result column="creator_id" property="creatorId"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO activity_topic (activity_id, title, creator_id, created_at, updated_at)
        VALUES (#{activityId}, #{title}, #{creatorId}, NOW(), NOW())
    </insert>

    <update id="updateById">
        UPDATE activity_topic
        <set>
            <if test="title != null">title = #{title},</if>
            updated_at = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM activity_topic WHERE id = #{id}
    </delete>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM activity_topic WHERE id = #{id}
    </select>

    <select id="selectByActivityId" resultMap="BaseResultMap">
        SELECT * FROM activity_topic
        WHERE activity_id = #{activityId}
        ORDER BY created_at DESC
    </select>

    <select id="selectByCreatorId" resultMap="BaseResultMap">
        SELECT * FROM activity_topic
        WHERE creator_id = #{creatorId}
        ORDER BY created_at DESC
    </select>

</mapper>
