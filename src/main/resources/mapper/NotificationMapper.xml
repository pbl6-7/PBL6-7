<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.activity.mapper.NotificationMapper">

    <resultMap id="BaseResultMap" type="com.campus.activity.entity.Notification">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="activity_id" property="activityId"/>
        <result column="title" property="title"/>
        <result column="type" property="type"/>
        <result column="content" property="content"/>
        <result column="is_read" property="isRead"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.campus.activity.entity.Notification" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO notification (user_id, activity_id, title, type, content, is_read, create_time)
        VALUES (#{userId}, #{activityId}, #{title}, #{type}, #{content}, #{isRead}, NOW())
    </insert>

    <!--
        批量插入通知
        优化说明：
        1. 使用MyBatis的foreach标签实现批量插入
        2. 单次批量插入建议不超过500条记录
        3. 批量插入比循环单条插入性能提升显著
        4. 使用复合索引idx_user_read优化用户未读通知查询
    -->
    <insert id="batchInsert" parameterType="java.util.List" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO notification (user_id, activity_id, title, type, content, is_read, create_time)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.userId}, #{item.activityId}, #{item.title}, #{item.type}, #{item.content}, #{item.isRead}, NOW())
        </foreach>
    </insert>

    <update id="updateIsRead">
        UPDATE notification
        SET is_read = 1
        WHERE id = #{id}
    </update>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM notification
        WHERE id = #{id}
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM notification
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countByUserId" resultType="int">
        SELECT COUNT(*) FROM notification
        WHERE user_id = #{userId}
    </select>

    <select id="countUnreadByUserId" resultType="int">
        SELECT COUNT(*) FROM notification
        WHERE user_id = #{userId} AND is_read = 0
    </select>

    <select id="selectByActivityId" resultMap="BaseResultMap">
        SELECT * FROM notification
        WHERE activity_id = #{activityId}
        ORDER BY create_time DESC
    </select>

    <!--
        游标分页查询用户通知（基于lastId）
        优化说明：
        1. 对于大数据量，使用基于ID的分页避免OFFSET性能问题
        2. WHERE id < lastId LIMIT N 比 OFFSET性能更好
        3. 适用于无限滚动或大数据量场景
        4. 使用复合索引idx_user_read优化查询
    -->
    <select id="selectByUserIdWithCursor" resultMap="BaseResultMap">
        SELECT * FROM notification
        WHERE user_id = #{userId}
        <if test="lastId != null">
            AND id &lt; #{lastId}
        </if>
        ORDER BY id DESC
        LIMIT #{size}
    </select>

</mapper>
